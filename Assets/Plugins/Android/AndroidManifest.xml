<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- AndroidManifest.xml - Samsung Galaxy XR (Android XR) 호환 매니페스트 -->
<!-- UnityPlayerActivity는 선언하지 않음 - Android XR에서는 UnityPlayerGameActivity만 사용 -->
<!-- FixAndroidManifest.cs가 빌드 시 UnityPlayerGameActivity에 LAUNCHER를 자동 추가 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/app_icon"
      android:allowBackup="false">

    <!-- 퍼미션 다이얼로그 스킵 여부 -->
    <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="false" />
    <!-- Samsung XR VR 전용 모드 설정 -->
    <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />
  </application>

  <!-- Eye Tracking 퍼미션 (Android XR에서 시선 추적에 필요) -->
  <uses-permission android:name="android.permission.EYE_TRACKING" />

  <!-- Hand Tracking 퍼미션 (Android XR에서 손 추적에 필요) -->
  <uses-permission android:name="android.permission.HAND_TRACKING" />
  <uses-feature android:name="android.hardware.xr.input.hand_tracking" android:required="false" />

  <!-- VR 헤드 트래킹 하드웨어 요구사항 (Android XR 표준) -->
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

</manifest>
